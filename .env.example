# Copy this file to .env and fill in your real key:
#   cp .env.example .env
# .env is ignored by git; this example file is committed so others know what's needed.

RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Platform = the server (league, mastery, spectator endpoints). LAN = la1
RIOT_PLATFORM=la1
# Region = the routing cluster (account, match endpoints). LAN belongs to americas
RIOT_REGION=americas
